PORT=4000

# From Google Cloud Console: APIs & Services, Credentials, an OAuth client of type "Web application".
# Enable the Google Classroom API and the Google Calendar API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google sends the user after consent. It must also be listed under "Authorized redirect URIs"
# for the client. Locally this is the first line; on Vercel set it to your deployed address, e.g.
# https://api.example.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

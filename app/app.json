{
  "expo": {
    "name": "Clingy",
    "slug": "clingy",
    "version": "1.0.0",
    "scheme": "clingy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.clingy",
      "adaptiveIcon": {
        "backgroundColor": "#0f131c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-fast-tflite",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/overlay",
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cling uses the camera to read your Certificate of Registration.",
          "photosPermission": "Cling reads the photo of your Certificate of Registration you choose."
        }
      ]
    ]
  }
}

# Where the app finds the backend (see ../backend). This is baked into the app when it is built.
#
# Copy this to .env (not committed) and set it to your deployed backend, or, to run the backend on
# your own computer, to your computer's address on the local network (find it with `hostname -I`).
# A phone can't reach "localhost" on your computer.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:4000

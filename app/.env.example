# Non-secret: the backend's LAN address, used by the dev client on a physical
# device (localhost won't reach the dev machine from the phone). Copy this to
# .env (gitignored) and set it to YOUR machine's LAN IP running the backend
# (check with `hostname -I` / `ip route get 1`), not the example value below.
EXPO_PUBLIC_BACKEND_URL=http://192.168.100.11:4000
